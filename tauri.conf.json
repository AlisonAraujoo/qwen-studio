{
  "$schema": "./node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Qwen Studio",
  "version": "2.2.3",
  "identifier": "com.qwen.studio",
  "build": {},
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "mcp-proxy-server.js"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["webkit2gtk-4.1"],
        "desktopTemplate": "qwen-studio.desktop"
      },
      "rpm": {
        "depends": ["webkit2gtk4.1"],
        "desktopTemplate": "qwen-studio.desktop",
        "compression": {
          "type": "none"
        }
      }
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [],
      "desktop": {
        "schemes": ["qwen"]
      }
    }
  }
}
